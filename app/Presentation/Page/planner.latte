{block content}
<h1>Play Planner</h1><p class="text-body-secondary mb-4">One game, a small goal, and a little time. Save a plan for your next few sessions.</p>
<div class="row g-4">
    <div class="col-lg-8">
        <form n:name="plannerForm" id="plannerForm" class="card card-body p-3 p-md-4">
            <div n:if="$form->hasErrors()" class="alert alert-danger" role="alert"><ul class="mb-0"><li n:foreach="$form->getErrors() as $error">{$error}</li></ul></div>
            <h2 class="h5 mb-3">Your next game</h2>
            <div class="row g-3">
                <div class="col-md-6"><label n:name="planName" class="form-label">Plan name</label><input n:name="planName" class="form-control" placeholder="A few evenings in Pelican Town" maxlength="80" required></div>
                <div class="col-md-6"><label n:name="game" class="form-label">Game</label><select n:name="game" class="form-select" required></select></div>
                <div class="col-md-6"><label n:name="nickname" class="form-label">Nickname <span class="text-body-secondary fw-normal">(optional)</span></label><div class="input-group"><span class="input-group-text" aria-hidden="true">@</span><input n:name="nickname" class="form-control" maxlength="40" placeholder="Player one" aria-describedby="nicknameHelp"></div><div id="nicknameHelp" class="form-text">A nickname is enough. No real name needed.</div></div>
                <div class="col-md-6"><label n:name="platform" class="form-label">Platform</label><select n:name="platform" class="form-select" required aria-describedby="platformHelp"></select><div id="platformHelp" class="form-text">Choose a platform on which you own the selected game.</div></div>
            </div>
            <h2 class="h5 mt-4 mb-3">Make some time</h2>
            <div class="row g-3">
                <div class="col-md-6"><label n:name="startDate" class="form-label">Start date</label><input n:name="startDate" class="form-control" required></div>
                <div class="col-md-6"><label n:name="sessions" class="form-label">Sessions per week</label><input n:name="sessions" class="form-control" min="1" max="7" required></div>
                <div class="col-md-6"><label n:name="minutes" class="form-label">Session length</label><div class="input-group"><input n:name="minutes" class="form-control" min="15" max="240" required aria-describedby="minutesUnit"><span class="input-group-text" id="minutesUnit">minutes</span></div></div>
                <div class="col-md-6"><label n:name="pace" class="form-label">Pace</label><select n:name="pace" class="form-select"></select></div>
                <fieldset class="col-12"><legend class="fs-6 mb-2">Play style</legend>{foreach $form['mode']->getItems() as $key => $label}<div class="form-check form-check-inline"><input n:name="mode:$key" class="form-check-input" required><label n:name="mode:$key" class="form-check-label">{$label}</label></div>{/foreach}</fieldset>
            </div>
            <h2 class="h5 mt-4 mb-3">Keep it simple</h2>
            <div class="mb-3"><label n:name="goal" class="form-label">Session goal</label><input n:name="goal" class="form-control" placeholder="Finish one quest, solve a puzzle, or explore somewhere new" maxlength="120" required><div class="form-text">A small goal is easier to enjoy.</div></div>
            <div class="mb-3"><label n:name="notes" class="form-label">Notes <span class="text-body-secondary fw-normal">(optional)</span></label><textarea n:name="notes" class="form-control" rows="3" maxlength="2000" placeholder="Anything you want to remember next time..."></textarea></div>
            <div class="form-check mb-2"><input n:name="breaks" class="form-check-input"><label n:name="breaks" class="form-check-label">Include a break between sessions</label></div>
            <div class="form-check mb-3"><input n:name="confirm" class="form-check-input" required><label n:name="confirm" class="form-check-label">I understand that this plan is saved for this browser only.</label></div>
            <button n:name="save" class="btn btn-primary align-self-start" type="submit"><img src="assets/icons/calendar-check.svg" width="18" height="18" class="me-1" alt=""> Save</button>
            <p class="small text-body-secondary mb-0 mt-3">{if $staticPreview}Saved on this device in this browser. Nothing is sent to a server.{else}Saved in your browser session for up to seven days. Nothing is published.{/if}</p>
        </form>
    </div>
    <aside class="col-lg-4">
        <section class="card card-body" id="savedPlan" aria-live="polite">
            <h2 class="h5">Your saved plan</h2>
            <div id="planSummary">
                {if $plan}
                    <h3 class="h6 mt-2">{$plan['planName']}</h3>
                    <p class="text-body-secondary">{$form['game']->getItems()[$plan['game']]}</p>
                    <dl class="row small"><dt class="col-5">Start</dt><dd class="col-7">{$plan['startDate']}</dd><dt class="col-5">Schedule</dt><dd class="col-7">{$plan['sessions']} × {$plan['minutes']} min / week</dd><dt class="col-5">Platform</dt><dd class="col-7">{$plan['platform']}</dd><dt class="col-5">Style</dt><dd class="col-7">{$form['mode']->getItems()[$plan['mode']]} · {$plan['pace']}</dd></dl>
                    <p class="mb-0">{$plan['goal']}</p><p n:if="$plan['notes']" class="small text-body-secondary mt-2 mb-0">{$plan['notes']}</p>
                {else}<p class="text-body-secondary mb-0">No plan yet. Fill in the form and press Save. Your plan will appear here.</p>{/if}
            </div>
        </section>
        <div id="plannerStatus" role="status" class="mt-3"></div>
        <p class="small text-body-secondary mt-3">Not sure what to pick? <a n:href="genres">Explore a few genres</a>.</p>
    </aside>
</div>
