{block content}
<section class="hero" aria-labelledby="hero-title">
    <picture class="hero-photo">
        <source media="(max-width: 600px)" srcset="assets/images/hero-mobile.webp">
        <img src="assets/images/hero.webp" width="1800" height="840" alt="" fetchpriority="high">
    </picture>
    <div class="page-width hero-copy">
        <h1 id="hero-title">Najděte místo,<br class="hero-break"> kde chcete žít.</h1>
        <p>Novostavby v Česku a bydlení u moře na jednom místě.</p>
    </div>
</section>

{var $categories = [
    ['#projekty', 'buildings', 'Novostavby v Česku', 'Byty a rodinné domy'],
    ['#u-more', 'sun', 'Bydlení u moře', 'Rezidence na pobřeží'],
    ['#', 'key', 'Hypotéky', 'Financování bydlení'],
    ['#', 'growth', 'Investice', 'Nemovitosti k pronájmu'],
]}
<section class="page-width categories" aria-labelledby="categories-title">
    <h2 id="categories-title">Co právě hledáte?</h2>
    <ul class="category-grid list-unstyled mb-0">
        {foreach $categories as [$target, $icon, $name, $description]}
            <li>
                <a class="category-card" href="{$target}" n:attr="aria-disabled: $target === '#' ? 'true' : null">
                    <span class="category-icon" aria-hidden="true"><span class="icon icon-{$icon}"></span></span>
                    <span class="category-name">{$name}</span>
                    <span class="category-description">{$description}</span>
                </a>
            </li>
        {/foreach}
    </ul>
</section>

<section class="page-width projects section-spacing" id="projekty" aria-labelledby="projects-title">
    <div class="section-heading">
        <div>
            <h2 id="projects-title" tabindex="-1">Novostavby v Česku</h2>
            <p>Od městských bytů po rodinné domy se zahradou.</p>
        </div>
        <a class="button-outline" href="#" aria-disabled="true">Všechny novostavby</a>
    </div>

    <div class="search-feedback" id="search-feedback" hidden>
        <p id="search-summary" role="status"></p>
        <button class="button-outline" id="search-reset" type="button">Zrušit hledání</button>
    </div>
    {include projectGrid, projects: $domesticProjects}
</section>

<section class="page-width guide section-spacing" id="pruvodce" aria-labelledby="guide-title">
    <div class="guide-panel">
        <div class="guide-copy">
            <h2 id="guide-title">Jak vybírat nové bydlení</h2>
            <ul class="guide-steps list-unstyled">
                <li>
                    <span class="step-icon icon icon-compass" aria-hidden="true"></span>
                    <div><h3>Porovnejte lokality</h3><p>Prověřte spojení do práce, školy i možnosti trávení volného času.</p></div>
                </li>
                <li>
                    <span class="step-icon icon icon-wallet" aria-hidden="true"></span>
                    <div><h3>Sestavte si rozpočet</h3><p>Počítejte s cenou bytu, vybavením i náklady na provoz.</p></div>
                </li>
                <li>
                    <span class="step-icon icon icon-calendar" aria-hidden="true"></span>
                    <div><h3>Naplánujte prohlídku</h3><p>Srovnejte půdorysy a místo si prohlédněte osobně.</p></div>
                </li>
            </ul>
            <a class="button-primary" href="#projekty">Prohlédnout novostavby</a>
        </div>
        <img class="guide-photo" src="assets/images/obyvaci-pokoj.webp" width="1000" height="850" loading="lazy" alt="">
    </div>
</section>

<section class="coastal section-spacing" id="u-more" aria-labelledby="coastal-title">
    <div class="page-width">
        <div class="section-heading">
            <div>
                <h2 id="coastal-title">Bydlení u moře</h2>
                <p>Vily a apartmány od španělského pobřeží po řecké ostrovy.</p>
            </div>
            <a class="button-outline" href="#" aria-disabled="true">Všechny zahraniční projekty</a>
        </div>
        {include projectGrid, projects: $coastalProjects}
    </div>
</section>
{/block}

{define projectGrid, array $projects}
<div class="project-grid">
    {foreach $projects as $project}
        <article class="project-card">
            <a class="project-link" href="#" aria-disabled="true">
                <div class="project-photo">
                    <img src="assets/images/{$project['image']}.webp" width="800" height="520" alt="" loading="lazy">
                    <span class="project-kind">{$project['type']}</span>
                </div>
                <div class="project-copy">
                    <h3>{$project['name']}</h3>
                    <p class="project-location">
                        <span class="icon icon-location" aria-hidden="true"></span>
                        {$project['location']}
                    </p>
                    <div class="project-facts">
                        <span>{$project['details']}</span>
                        <strong>od {$project['price']}</strong>
                    </div>
                </div>
            </a>
        </article>
    {/foreach}
</div>
{/define}
