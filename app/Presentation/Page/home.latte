{block content}
<div id="featuredGames" class="carousel slide overflow-hidden rounded-3 mb-5" data-bs-theme="light" data-bs-ride="carousel" data-bs-interval="6500">
    <div class="carousel-indicators">
        <button n:foreach="$featured as $game" type="button" data-bs-target="#featuredGames" data-bs-slide-to="{$iterator->counter0}" n:class="$iterator->first ? active" aria-current="{$iterator->first ? 'true' : 'false'}" aria-label="{$game['title']}"></button>
    </div>
    <div class="carousel-inner">
        <div n:foreach="$featured as $game" n:class="carousel-item, $iterator->first ? active">
            <img src="assets/images/{$game['image']}" class="d-block w-100 hero-image" alt="Gameplay screenshot from {$game['title']}" width="1920" height="1080" fetchpriority="{$iterator->first ? 'high' : 'auto'}">
            <div class="carousel-caption text-start">
                <span class="badge text-bg-primary mb-2">{$game['genre']} · {$game['title']}</span>
                {if $iterator->first}<h1>{$game['headline']}</h1>{else}<h2 class="h1">{$game['headline']}</h2>{/if}
                <p>{$game['intro']}</p>
                <a href="{link reviews}#game-{$game['id']}" class="btn btn-primary">Read the notes <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#featuredGames" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous slide</span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#featuredGames" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next slide</span></button>
    <button id="carouselPause" type="button" class="btn btn-sm btn-dark carousel-pause" aria-pressed="false">Pause</button>
</div>
<section class="mb-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
        <div><p class="text-primary small fw-semibold mb-1">WELCOME TO PLAYLOG</p><h2 class="h3 mb-2">A good game for your next evening.</h2><p class="text-body-secondary mb-0">Browse the library, read a few notes, and make a small plan.</p></div>
        <a n:href="games" class="btn btn-outline-light flex-shrink-0">Browse all 60 games</a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div n:foreach="$featured as $game" class="col">
            <article class="card h-100">
                <img src="assets/images/{$game['image']}" class="card-img-top game-image" width="640" height="360" loading="lazy" alt="Gameplay from {$game['title']}">
                <div class="card-body d-flex flex-column align-items-start">
                    <span class="text-body-secondary small mb-2">{$game['genre']} · {$game['year']}</span>
                    <h3 class="h5">{$game['title']}</h3><p class="text-body-secondary">{$game['intro']}</p>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-auto" data-bs-toggle="modal" data-bs-target="#gameDetails" data-game-title="{$game['title']}" data-game-description="{$game['summary']}" data-game-developer="{$game['developer']}" data-game-release="{$game['released']}" data-game-url="{$game['source']}">Quick look</button>
                </div>
            </article>
        </div>
    </div>
</section>
<section class="row align-items-center g-3 border-top pt-4">
    <div class="col-md-8"><h2 class="h4">Less scrolling. More playing.</h2><p class="text-body-secondary mb-0">Choose one game and a small goal for your next session.</p></div>
    <div class="col-md-4 text-md-end"><a n:href="planner" class="btn btn-success"><img src="assets/icons/calendar-check.svg" width="18" height="18" class="me-1" alt=""> Make a play plan</a></div>
</section>
{include '../_gameModal.latte'}
