{block content}
<h1>Reviews &amp; notes</h1><p class="text-body-secondary mb-4">Three short, spoiler-free looks at three very different games.</p>
<article n:foreach="$featured as $game" class="row g-4 mb-5 pb-4 border-bottom" id="game-{$game['id']}">
    <div class="col-md-5"><img src="assets/images/{$game['image']}" width="640" height="360" loading="lazy" class="img-fluid rounded-3" alt="Gameplay screenshot from {$game['title']}"></div>
    <div class="col-md-7"><span class="badge text-bg-secondary mb-2">{$game['genre']}</span><h2 class="h3">{$game['title']}</h2><p>{$game['summary']}</p><h3 class="h6">Why give it a look?</h3><p class="text-body-secondary">{$game['note']}</p><a href="{$game['source']}" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">Game details on Steam ↗</a> <a n:href="planner" class="btn btn-outline-light btn-sm">Plan a session</a></div>
</article>
<section id="trailer">
    <h2 class="h4">Portal 2 in motion</h2>
    <p class="text-body-secondary">Watch Valve's original teaser for a glimpse of Aperture Science.</p>
    <div class="row">
        <div class="col-lg-8">
            <div class="ratio ratio-16x9 rounded-3 overflow-hidden">
                <iframe src="https://www.youtube-nocookie.com/embed/tax4e4hBBZc?rel=0" title="Portal 2 Teaser Trailer by Valve" loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
    </div>
    <p class="small text-body-secondary mt-2">Video by Valve. <a href="https://www.youtube.com/watch?v=tax4e4hBBZc" target="_blank" rel="noopener">Watch on YouTube ↗</a></p>
</section>
