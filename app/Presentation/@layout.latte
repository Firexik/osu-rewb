<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Nové Místo je ukázkový přehled novostaveb v Česku a rezidencí u moře.">
    <meta name="theme-color" content="#ffffff">
    <title>Nové Místo – Novostavby v Česku a u moře</title>
    <link rel="icon" href="assets/images/nove-misto.png" type="image/png">
    <link rel="stylesheet" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/style.css">
    <script src="assets/js/app.js" defer></script>
</head>
<body id="zacatek">
<a class="skip-link visually-hidden-focusable" href="#obsah">Přejít k obsahu</a>

<header class="site-header">
    <div class="page-width header-inner">
        <a class="brand" href="#zacatek" aria-label="Nové Místo – úvod">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>nové<span class="brand-accent">místo</span></span>
        </a>

        <form class="header-search" id="project-search" action="#projekty" method="get" role="search" aria-label="Vyhledat projekty v Česku">
            <label class="visually-hidden" for="project-query">Město, název projektu nebo dispozice</label>
            <span class="icon icon-search search-icon" aria-hidden="true"></span>
            <input id="project-query" name="q" type="search" placeholder="Město nebo projekt" maxlength="80">
            <button class="search-button" type="submit">Hledat</button>
        </form>

        <div class="header-actions">
            <a class="button-primary header-contact" href="#" aria-disabled="true">Kontaktujte nás</a>
            <details class="header-menu" id="header-menu">
                <summary class="menu-toggle" aria-label="Hlavní nabídka">
                    <span class="icon icon-menu" aria-hidden="true"></span>
                    <span class="icon icon-close" aria-hidden="true"></span>
                </summary>
                <nav class="menu-panel" aria-label="Hlavní navigace">
                    <a href="#projekty">Novostavby v Česku</a>
                    <a href="#u-more">Bydlení u moře</a>
                    <a href="#pruvodce">Průvodce výběrem</a>
                    <a href="#" aria-disabled="true">Hypotéky</a>
                    <a href="#" aria-disabled="true">Investice</a>
                    <a href="#" aria-disabled="true">Kontaktujte nás</a>
                </nav>
            </details>
        </div>
    </div>
</header>

<main id="obsah" tabindex="-1">
    {include content}
</main>

<footer class="site-footer">
    <div class="page-width footer-main">
        <div class="footer-intro">
            <a class="brand" href="#zacatek" aria-label="Nové Místo – zpět na začátek">
                <span class="brand-mark" aria-hidden="true"></span>
                <span>nové<span class="brand-accent">místo</span></span>
            </a>
            <p>Přehled novostaveb v Česku a rezidencí u moře.</p>
        </div>
        <nav class="footer-nav" aria-label="Navigace v zápatí">
            <div>
                <h2>Nemovitosti</h2>
                <a href="#projekty">Projekty v Česku</a>
                <a href="#u-more">Bydlení u moře</a>
                <a href="#pruvodce">Průvodce výběrem</a>
            </div>
            <div>
                <h2>Nové Místo</h2>
                <a href="#" aria-disabled="true">O nás</a>
                <a href="#" aria-disabled="true">Pro developery</a>
                <a href="#" aria-disabled="true">Kontakt</a>
            </div>
        </nav>
    </div>
    <div class="page-width footer-bottom">
        <p>Ukázkový realitní web. Projekty, ceny a fotografie jsou ilustrační.</p>
        <a href="#zacatek">Zpět nahoru</a>
    </div>
</footer>
</body>
</html>
