<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Playlog is a small gaming catalogue with game notes, genre guides and a personal play planner.">
    <title>{$pageTitle} · Playlog</title>
    <link rel="icon" href="assets/icons/controller.svg" type="image/svg+xml">
    <link rel="stylesheet" href="assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/style.css">
    {block head}{/block}
</head>
<body data-static-preview="{$staticPreview ? 'true' : 'false'}" class="d-flex flex-column min-vh-100">
<a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>
<header class="border-bottom">
    <nav class="navbar navbar-expand-lg bg-body-tertiary" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" n:href="home">
                <img src="assets/icons/controller.svg" width="26" height="26" alt=""> Playlog<span class="text-primary">.</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto gap-lg-1">
                    {foreach $pages as $action => [$label, $icon]}
                        <li class="nav-item"><a n:href="$action" n:class="nav-link, $presenter->isLinkCurrent($action) ? active" aria-current="{$presenter->isLinkCurrent($action) ? 'page' : 'false'}"><img src="assets/icons/{$icon}.svg" width="15" height="15" class="nav-icon me-1" alt="">{$label}</a></li>
                    {/foreach}
                </ul>
            </div>
        </div>
    </nav>
</header>
<main id="main" class="container py-4 py-md-5 flex-grow-1" tabindex="-1">
    <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small">
            {if $presenter->getAction() === 'home'}
                <li class="breadcrumb-item active" aria-current="page">Home</li>
            {else}
                <li class="breadcrumb-item"><a n:href="home">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">{$pageTitle}</li>
            {/if}
        </ol>
    </nav>
    <div n:foreach="$flashes as $flash" class="alert alert-{$flash->type}" role="status">{$flash->message}</div>
    {include content}
</main>
<footer class="border-top py-4 mt-4">
    <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary">
        <span><strong class="text-body">Playlog.</strong> A little space for good games.</span>
        <a href="{link about}#sources" class="link-secondary">About &amp; sources</a>
    </div>
</footer>
<script src="assets/js/bootstrap.bundle.min.js"></script>
<script src="assets/js/app.js"></script>
{block scripts}{/block}
</body>
</html>
