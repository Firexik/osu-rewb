<div class="modal fade" id="gameDetails" tabindex="-1" aria-labelledby="gameDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title fs-5" id="gameDetailsLabel">Game details</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body"><p id="gameDescription"></p><dl class="row mb-0"><dt class="col-sm-4">Developer</dt><dd class="col-sm-8" id="gameDeveloper"></dd><dt class="col-sm-4">Steam release</dt><dd class="col-sm-8" id="gameRelease"></dd></dl></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button><a id="gameStore" href="https://store.steampowered.com/" class="btn btn-primary" target="_blank" rel="noopener">View on Steam <span aria-hidden="true">↗</span></a></div>
        </div>
    </div>
</div>
