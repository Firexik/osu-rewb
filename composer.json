{
    "name": "firexik/rewb-playlog",
    "description": "Playlog: a simple responsive gaming website for REWB, built with Nette and Bootstrap.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/forms": "^3.2",
        "latte/latte": "^3.1",
        "tracy/tracy": "^2.10"
    },
    "autoload": {"psr-4": {"App\\": "app/"}},
    "scripts": {
        "serve": "@php -S 127.0.0.1:8001 -t www www/router.php",
        "export": "@php bin/export.php"
    },
    "config": {"sort-packages": true, "allow-plugins": false}
}
